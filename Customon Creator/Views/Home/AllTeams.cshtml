@model IEnumerable<Customon_Creator.Models.Entities.ApplicationUser>

@{
    ViewData["Title"] = "All Teams";
}

<h1>Teams</h1>

<table class="table">
    <thead>
        <tr>
            <th>
                Creator
            </th>
            <th>
                Slot #1
            </th>
            <th>
                Slot #2
            </th>
            <th>
                Slot #3
            </th>
            <th>
                Slot #4
            </th>
            <th>
                Slot #5
            </th>
            <th>
                Slot #6
            </th>
        </tr>
    </thead>
    <tbody class="table-group-divider">
        @foreach (var item in Model) {
            if (item.Pokemon.Any()) {
                <tr>
                    <td class="text-truncate" style="text-overflow: ellipsis">
                        @(item.UserName)'s Team
                    </td>
                    @for (int i = 1; i <= 6; i++) {
                        var mon = item.Pokemon.FirstOrDefault(p => p.TeamSlot == i);
                        if (mon != null) {
                            <td>
                                <a asp-controller="Pokemon" asp-action="Details" asp-route-id="@mon.Id">@mon.Name</a>
                            </td>
                        }
                        else {
                            <td>
                                Empty...
                            </td>
                        }
                    }
                </tr>
            }
        }
    </tbody>
</table>
