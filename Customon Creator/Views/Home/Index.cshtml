@{
    ViewData["Title"] = "Home Page";
}
<br />
<div class="text-center">
    <h1 class="display-4">Welcome to Customon Creator!</h1>
    <p>Build and design your own custom Pokemon and moves, save them to your team, and share them with others!</p>
    <h3>Stats:</h3>
    <p>Total number of Customon Users: @ViewBag.Users</p>
    <p>Total number of Custom Pokemon: @ViewBag.Pokemon</p>
    <p>Total number of Custom Moves: @ViewBag.Moves</p>

</div>
