@model IEnumerable<Customon_Creator.Models.Entities.Move>

@{
    ViewData["Title"] = "Moves";
}

<h1>My Moves</h1>

<p>
    <a asp-action="Create" class="btn btn-success">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Type)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Category)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Power)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Accuracy)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody class="table-group-divider">
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                <span class="badge color-@item.Type">
                    @Html.DisplayFor(modelItem => item.Type)
                </span>
            </td>
            <td>
                    <span class="badge rounded-pill color-@item.Category">
                    @Html.DisplayFor(modelItem => item.Category)
                </span>
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Power)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Accuracy)
            </td>
                <td>
                    <a type="button" class="btn btn-warning" asp-action="Edit" asp-route-id="@item.Id">Edit</a>&nbsp;&nbsp;
                    <a type="button" class="btn btn-info" asp-action="Details" asp-route-id="@item.Id">Details</a>&nbsp;&nbsp;
                    <a type="button" class="btn btn-danger" asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                </td>
        </tr>
}
    </tbody>
</table>
