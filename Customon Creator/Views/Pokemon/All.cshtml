@model IEnumerable<Customon_Creator.Models.Entities.Pokemon>

@{
    ViewData["Title"] = "Pokemon";
}

<h1>Pokemon</h1>

<table class="table table-hover w-100" style="table-layout: fixed;">
    <thead>
        <tr>
            <th style="width: 15%;">
                Creator
            </th>
            <th style="max-width: 30%; width: 30%;">
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th style="max-width: 50%; width: 30%;">
                @Html.DisplayNameFor(model => model.Description)
            </th>
            <th style="max-width: 10%;">
                Type
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody class="table-group-divider">
        @foreach (var item in Model) {
            <tr>
                <td class="text-truncate" style="text-overflow: ellipsis">
                    @item.User!.UserName
                </td>
                <td class="text-truncate" style="text-overflow: ellipsis">
                    @Html.DisplayFor(modelItem => item.Name)
                </td>
                <td class="text-truncate" style="text-overflow: ellipsis">
                    @Html.DisplayFor(modelItem => item.Description)
                </td>
                <td>
                    <span class="badge color-@item.Type1">
                        @Html.DisplayFor(modelItem => item.Type1)
                    </span>
                    <br />
                    <span class="badge color-@item.Type2">
                        @Html.DisplayFor(modelItem => item.Type2)
                    </span>
                </td>
                <td>
                    <a type="button" class="btn btn-info" asp-action="Details" asp-route-id="@item.Id">Details</a>
                </td>
            </tr>
        }
    </tbody>
</table>
