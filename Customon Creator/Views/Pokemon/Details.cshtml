@model Customon_Creator.Models.Entities.Pokemon

@{
    ViewData["Title"] = "Details";
}

<h1>Pokemon Details</h1>

<div>
    <a class="btn btn-outline-primary" href="javascript:history.go(-1)"><i class="bi bi-arrow-bar-left"></i> Go Back</a>
</div>

<div>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Name)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Name)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Description)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Description)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Type1)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Type1)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Type2)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Type2)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.HP)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.HP)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Attack)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Attack)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Defense)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Defense)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.SpAtk)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.SpAtk)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.SpDef)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.SpDef)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Speed)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Speed)
        </dd>
        <dt class="col-sm-2">
            Moves
        </dt>
        <dd class="col-sm-10">
            @foreach (var move in Model.MoveList.Select(m => m.Move).ToList()) {
                <a asp-controller="Move" asp-action="Details" asp-route-id="@move?.Id">@move?.Name</a>
            }
        </dd>
    </dl>
</div>
@if (ViewBag.isOwner) {
    <div>
        <a type="button" class="btn btn-warning" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
    </div>
}