@model IEnumerable<Customon_Creator.Models.Entities.Pokemon>

@{
    ViewData["Title"] = "Pokemon";
}

<h1>My Pokemon</h1>

<p>
    <a asp-action="Create" class="btn btn-success">Create New</a>
</p>
<table class="table table-hover w-100" style="table-layout: fixed;">
    <thead>
        <tr>
            <th style="max-width: 50%;">
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th style="max-width: 50%;">
                Type
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody class="table-group-divider">
@foreach (var item in Model) {
        <tr>
                <td class="text-truncate" style="text-overflow: ellipsis">
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                    <span class="badge color-@item.Type1">
                        @Html.DisplayFor(modelItem => item.Type1)
                    </span>
                    <br />
                    <span class="badge color-@item.Type2">
                        @Html.DisplayFor(modelItem => item.Type2)
                    </span>
            </td>
            <td>
                    <a type="button" class="btn btn-warning" asp-action="Edit" asp-route-id="@item.Id">Edit</a>&nbsp;&nbsp;
                    <a type="button" class="btn btn-info" asp-action="Details" asp-route-id="@item.Id">Details</a>&nbsp;&nbsp;
                    <a type="button" class="btn btn-danger" asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
